{
  "name": "dsh-server-monitor",
  "version": "1.1.0-beta.1",
  "license": "MIT",
  "engines": { "dsh": "0.2.2-rc.5" },
  "keywords": ["dsh-plugin", "server-monitor", "ssh", "linux"],
  "type": "module",
  "description": "Read-only real-time Linux server metrics panel with a left sidebar entry.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "docs/monitoring-dashboard-research.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
