{
  "name": "dsh-server-pulse",
  "version": "1.3.0",
  "license": "MIT",
  "author": "xiaowill",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0 || >=0.2.1-rc.1 <0.3.0 || >=0.2.2-rc.1 <0.3.0",
    "node": ">=22.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "server-monitoring",
    "server-pulse",
    "ssh",
    "linux",
    "prometheus",
    "grafana",
    "uptime-kuma"
  ],
  "type": "module",
  "description": "Read-only real-time Linux server & monitoring services panel over OpenSSH for DeepSeek Harness.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/installation.md",
    "docs/architecture.md",
    "docs/assets/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "homepage": "https://github.com/xiaowill/dsh-server-pulse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaowill/dsh-server-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/xiaowill/dsh-server-pulse/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check host/collector.js && node --check host/ssh.js && node --check host/targets.js && node --check host/ssh-config.js && node --check host/services.js",
    "test": "node --test"
  }
}
